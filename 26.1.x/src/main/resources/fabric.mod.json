{
  "schemaVersion": 1,
  "id": "universal_config",
  "version": "${version}",
  "name": "Universal Config",
  "description": "Share Minecraft keybinds, client settings, and mod configuration profiles across Minecraft instances.",
  "authors": [
    "yoima-jp",
    "tofuturu",
    "tanzana7"
  ],
  "contact": {
    "homepage": "https://modrinth.com/project/universal-config",
    "sources": "https://github.com/yoima-jp/UniversalConfig",
    "issues": "https://github.com/yoima-jp/UniversalConfig/issues/new/choose",
    "modrinth": "universal-config"
  },
  "license": "MIT",
  "icon": "assets/universal_config/icon.png",
  "environment": "client",
  "mixins": [
    "universal_config.mixins.json"
  ],
  "entrypoints": {
    "preLaunch": [
      "com.example.universalconfig.fabric.UniversalConfigPreLaunch"
    ],
    "client": [
      "com.example.universalconfig.fabric.UniversalConfigMod"
    ],
    "modmenu": [
      "com.example.universalconfig.fabric.UniversalConfigModMenuApi"
    ]
  },
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "26.1.x",
    "java": ">=25",
    "fabric-api": ">=0.155.0"
  },
  "suggests": {
    "modmenu": "*"
  }
}
